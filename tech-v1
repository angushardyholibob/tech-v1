<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=1440">
<title>holibob.tech — Version A</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ============================================================
   holibob.tech 2.0 — Version A
   Palette: Holibob Pantone set
   333 C #3FC1AC · 7708 C #005C77 · 432 C #333F48
   191 C #F4546F · 123 C #FFC72C · 637 C #41B6E6
   ============================================================ */
:root{
  --paper:#FFFFFF;
  --ink:#333F48;            /* PANTONE 432 C */
  --muted:#5F6B75;
  --hairline:#E4E6E8;
  --well:#F2F4F5;
  --field:#F6F7F8;
  --ocean:#005C77;          /* PANTONE 7708 C */
  --teal:#3FC1AC;           /* PANTONE 333 C */
  --teal-mid:#7FD5C7;
  --teal-wash:#E6F7F4;
  --pink:#F4546F;           /* PANTONE 191 C */
  --pink-text:#D0234A;      /* derived, text-safe */
  --gold:#FFC72C;           /* PANTONE 123 C */
  --cyan:#41B6E6;           /* PANTONE 637 C */
  --otb-yellow:#FFE300;
  --otb-blue:#0B2A6B;
  --tint-teal:#D3F0EB;
  --tint-cyan:#D8EFF9;
  --tint-pink:#FDDEE4;
  --grey-bar:#E3E3E8;
  --placeholder:#8A8A92;
  --display:"Inter Tight",system-ui,sans-serif;
  --body:system-ui,-apple-system,"Segoe UI",sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--paper);font-family:var(--body);color:var(--ink);-webkit-font-smoothing:antialiased}
.page{width:1440px;margin:0 auto;background:var(--paper)}
.row{display:flex;flex-direction:row}
.col{display:flex;flex-direction:column}
.rule{height:1px;background:var(--hairline)}

/* ---------- nav ---------- */
.nav{display:flex;align-items:center;justify-content:space-between;height:60px;padding:0 64px;border-bottom:1px solid var(--hairline)}
.wordmark{font-family:var(--display);font-size:20px;font-weight:700;letter-spacing:-.045em;color:var(--ink)}
.wordmark span{color:var(--teal)}
.navform{display:flex;align-items:center;gap:6px;width:340px;height:38px;padding:0 4px 0 14px;border:1px solid var(--hairline);border-radius:8px}
.navform .ph{flex:1;font-size:14px;color:var(--placeholder)}
.btn-sm{display:flex;align-items:center;justify-content:center;height:30px;padding:0 14px;background:var(--teal);border-radius:6px;font-size:13px;font-weight:500;color:var(--ink)}

/* ---------- hero ---------- */
.hero{display:flex;align-items:center;gap:48px;padding:72px 64px 88px}
.hero-left{width:644px;flex-shrink:0;display:flex;flex-direction:column;gap:32px}
h1{font-family:var(--display);font-size:64px;font-weight:700;letter-spacing:-.035em;line-height:64px;color:var(--ink)}
.sub{font-size:20px;line-height:31px;color:var(--muted);width:576px}
.heroform{display:flex;align-items:center;gap:8px;width:500px;height:60px;padding:0 5px 0 22px;background:var(--field);border:1px solid var(--hairline);border-radius:14px}
.heroform .ph{flex:1;font-size:16px;color:var(--placeholder)}
.btn{display:flex;align-items:center;justify-content:center;height:50px;min-width:152px;padding:0 20px;background:var(--teal);border-radius:10px;font-size:16px;font-weight:500;color:var(--ink)}
.ticks{display:flex;align-items:center;gap:20px;padding-top:2px}
.tick{display:flex;align-items:flex-start;gap:7px;font-size:14px;color:var(--muted)}
.tick svg{flex-shrink:0;margin-top:2px}

/* ---------- hero visual ---------- */
.visual{position:relative;width:620px;flex-shrink:0;display:flex;flex-direction:column;gap:20px;padding:30px;background:var(--hairline);border-radius:14px}
.dot-pink{position:absolute;top:-22px;right:-22px;width:64px;height:64px;border-radius:999px;background:var(--pink)}
.mocksearch{display:flex;align-items:center;gap:10px;height:48px;padding:0 6px 0 18px;background:#fff;border-radius:10px}
.mocksearch .q{flex:1;font-size:14px;color:var(--muted)}
.btn-search{display:flex;align-items:center;justify-content:center;height:36px;padding:0 16px;background:var(--ocean);border-radius:7px;font-size:13px;font-weight:500;color:#fff}
.cardrow{display:flex;gap:20px}
.card{width:258px;background:#fff;border-radius:10px;padding:12px;display:flex;flex-direction:column;gap:12px}
.card .img{height:132px;border-radius:7px;display:flex;align-items:flex-end;padding:10px}
.chip{padding:5px 10px;background:#fff;border-radius:999px;font-size:11px;font-weight:600;letter-spacing:.04em;color:var(--ink)}
.card .meta{display:flex;flex-direction:column;gap:7px;padding:0 4px 6px}
.card .name{font-family:var(--display);font-size:16px;font-weight:600;letter-spacing:-.02em;line-height:20px}
.card .stats{display:flex;align-items:center;gap:8px;font-size:13px}
.card .stats b{font-weight:600}
.card .stats .n{color:var(--placeholder)}
.card .stats .p{color:var(--ocean);font-weight:500}
.revenue{background:#fff;border-radius:10px;padding:18px 20px;display:flex;flex-direction:column;gap:16px}
.revenue .top{display:flex;align-items:baseline;justify-content:space-between}
.revenue .lbl{font-size:13px;color:var(--muted)}
.revenue .amt{font-family:var(--display);font-size:22px;font-weight:700;letter-spacing:-.03em}
.revenue .delta{font-size:13px;font-weight:600;color:var(--ocean);margin-left:10px}
.bars{display:flex;align-items:flex-end;gap:9px;height:56px}
.bars i{width:28px;border-radius:3px;background:var(--tint-teal);display:block}

/* ---------- social proof ---------- */
.proof{display:flex;flex-direction:column;align-items:center;gap:36px;padding:40px 64px 56px;background:var(--paper)}
.proof h2{font-family:var(--display);font-size:28px;font-weight:700;letter-spacing:-.03em}
.brands{display:flex;align-items:center;justify-content:space-between;width:1312px}
.brands span{font-family:var(--display);font-size:18px;font-weight:700;letter-spacing:-.03em;color:var(--ink)}

/* ---------- content sections ---------- */
.section{display:flex;flex-direction:column;gap:40px;padding:88px 64px 104px}
.section.s4{padding-top:8px}
.shead{display:flex;align-items:flex-end;justify-content:space-between;padding-bottom:16px}
.shead .l{display:flex;flex-direction:column;gap:20px;width:700px}
.label{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--ocean)}
.shead h2{font-family:var(--display);font-size:44px;font-weight:700;letter-spacing:-.035em;line-height:46px}
.shead .aside{width:420px;font-size:16px;line-height:26px;color:var(--muted);padding-bottom:6px}
.cells{display:flex;gap:40px}
.cell{display:flex;align-items:center;gap:24px;width:636px;flex-shrink:0}
.wellbox{width:298px;height:298px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:var(--teal-wash);border-radius:14px}
.copy{width:290px;display:flex;flex-direction:column;gap:18px}
.copy h3{font-family:var(--display);font-size:28px;font-weight:700;letter-spacing:-.03em;line-height:32px}
.copy p{font-size:16px;line-height:26px;color:var(--muted)}

/* ---------- mocks ---------- */
.mock{width:254px;background:#fff;border-radius:10px;padding:20px;display:flex;flex-direction:column}
.mock .cap{font-size:11px;font-weight:600;letter-spacing:.1em;color:var(--placeholder)}
.lrow{display:flex;align-items:center;justify-content:space-between;font-size:12px}
.lrow .v{width:70px;flex-shrink:0;font-weight:500}
.m-spend{gap:15px}
.m-spend .total{font-weight:600}
.m-spend .zero{width:70px;flex-shrink:0;font-weight:600;color:var(--pink-text)}
.m-store{gap:14px}
.m-store .title{display:flex;align-items:center;justify-content:space-between}
.m-store .title b{font-family:var(--display);font-size:14px;font-weight:700;letter-spacing:-.03em;color:var(--otb-blue)}
.m-store .title i{width:16px;height:16px;border-radius:999px;background:var(--otb-blue);display:block}
.swatches{display:flex;gap:8px}
.swatches i{width:66px;height:52px;border-radius:6px;display:block}
.lines{display:flex;flex-direction:column;gap:5px}
.lines i{height:7px;border-radius:999px;background:#E8E8EC;display:block}
.btn-store{display:flex;align-items:center;justify-content:center;height:32px;background:var(--cyan);border-radius:7px;font-size:12px;font-weight:600;color:var(--otb-blue)}
.m-when{gap:18px}
.tbars{display:flex;align-items:flex-end;gap:6px;height:74px}
.tbars i{width:26px;border-radius:3px;display:block;background:var(--grey-bar)}
.axis{display:flex;justify-content:space-between;font-size:11px;color:var(--placeholder)}
.pct{display:flex;align-items:baseline;gap:8px}
.pct b{font-family:var(--display);font-size:22px;font-weight:700;letter-spacing:-.03em;color:var(--ocean)}
.pct span{font-size:12px}
.m-match{gap:14px}
.m-match .who{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:500}
.m-match .who i{width:20px;height:20px;border-radius:999px;background:var(--tint-teal);display:block;flex-shrink:0}
.mrow{display:flex;align-items:center;gap:10px}
.mrow i{width:34px;height:34px;border-radius:6px;display:block;flex-shrink:0}
.mrow p{flex:1;font-size:12px;line-height:16px}
.mrow .s{width:34px;flex-shrink:0;font-size:12px;font-weight:600;color:var(--ocean);text-align:left}
.mrow.off p{color:var(--placeholder)}
.mrow.off .s{color:var(--placeholder);font-weight:500}

/* ---------- CTA ---------- */
.cta{display:flex;flex-direction:column;align-items:center;gap:26px;padding:88px 64px 96px;background:var(--ocean)}
.cta h2{width:760px;text-align:center;font-family:var(--display);font-size:52px;font-weight:700;letter-spacing:-.035em;line-height:54px;color:var(--teal-wash)}
.cta p{width:520px;text-align:center;font-size:18px;line-height:28px;color:var(--well)}
.ctaform{display:flex;align-items:center;gap:8px;width:500px;height:60px;padding:0 5px 0 22px;margin-top:6px;background:#fff;border:1px solid rgba(0,0,0,.10);border-radius:14px}
.ctaform .ph{flex:1;font-size:16px;color:var(--muted)}
.btn-cta{display:flex;align-items:center;justify-content:center;height:50px;min-width:152px;padding:0 20px;background:var(--teal);border-radius:10px;font-size:16px;font-weight:500;color:#fff}

/* ---------- footer ---------- */
.footer{display:flex;flex-direction:column;gap:44px;padding:56px 64px 40px}
.fcols{display:flex;align-items:flex-start;gap:64px}
.fbrand{width:360px;flex-shrink:0;display:flex;flex-direction:column;gap:14px}
.fbrand p{font-size:14px;line-height:23px;color:var(--muted)}
.fcol{width:190px;flex-shrink:0;display:flex;flex-direction:column;gap:12px}
.fcol b{font-size:13px;font-weight:600}
.fcol a{font-size:14px;color:var(--muted);text-decoration:none}
.fbase{display:flex;align-items:center;justify-content:space-between;padding-top:24px;border-top:1px solid var(--hairline);font-size:13px;color:var(--placeholder)}
.fbase .links{display:flex;gap:28px}
</style>
</head>
<body>
<div class="page">

  <!-- ===== NAV ===== -->
  <header class="nav">
    <div class="wordmark">holibob<span>.tech</span></div>
    <div class="navform">
      <div class="ph">What's your work email?</div>
      <div class="btn-sm">Get started free</div>
    </div>
  </header>

  <!-- ===== S1 · HOME / HERO ===== -->
  <section class="hero">
    <div class="hero-left">
      <h1>Increase revenue and customer retention — effortlessly.</h1>
      <p class="sub">Connect your travellers to an incredible world of things-to-do to earn incremental revenue and increase customer loyalty.</p>
      <div class="heroform">
        <div class="ph">What's your work email?</div>
        <div class="btn">Get started free</div>
      </div>
      <div class="ticks">
        <div class="tick"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7.2" stroke="#8A8A92" stroke-width="1.1"/><path d="M5 8.2L7.1 10.3L11.2 6.2" stroke="#8A8A92" stroke-width="1.3"/></svg><span>£200,000 per 1M marketable consumers</span></div>
        <div class="tick"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7.2" stroke="#8A8A92" stroke-width="1.1"/><path d="M5 8.2L7.1 10.3L11.2 6.2" stroke="#8A8A92" stroke-width="1.3"/></svg><span>35% higher repeat booking rate</span></div>
        <div class="tick"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7.2" stroke="#8A8A92" stroke-width="1.1"/><path d="M5 8.2L7.1 10.3L11.2 6.2" stroke="#8A8A92" stroke-width="1.3"/></svg><span>AI-matched to every traveller</span></div>
      </div>
    </div>

    <div class="visual">
      <div class="dot-pink"></div>
      <div class="mocksearch">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5.2" stroke="#8A8A92" stroke-width="1.3"/><path d="M11 11L14 14" stroke="#8A8A92" stroke-width="1.3"/></svg>
        <div class="q">Things to do in Kyoto · 12–14 Apr</div>
        <div class="btn-search">Search</div>
      </div>
      <div class="cardrow">
        <div class="card">
          <div class="img" style="background:var(--tint-teal)"><div class="chip">BESTSELLER</div></div>
          <div class="meta">
            <div class="name">Fushimi Inari at sunrise, private guide</div>
            <div class="stats"><b>4.9</b><span class="n">(2,411)</span><span class="n">·</span><span class="p">£62</span></div>
          </div>
        </div>
        <div class="card">
          <div class="img" style="background:var(--tint-cyan)"><div class="chip">NEW</div></div>
          <div class="meta">
            <div class="name">Nishiki market food walk, small group</div>
            <div class="stats"><b>4.8</b><span class="n">(867)</span><span class="n">·</span><span class="p">£41</span></div>
          </div>
        </div>
      </div>
      <div class="revenue">
        <div class="top">
          <div class="lbl">Experience revenue · April</div>
          <div><span class="amt">£48,210</span><span class="delta">+22%</span></div>
        </div>
        <div class="bars">
          <i style="height:22px"></i><i style="height:31px"></i><i style="height:26px"></i>
          <i style="height:38px"></i><i style="height:34px"></i>
          <i style="height:45px;background:var(--teal-mid)"></i>
          <i style="height:56px;background:var(--pink)"></i>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== S3 · SOCIAL PROOF ===== -->
  <section class="proof">
    <h2>Trusted by leading travel brands worldwide</h2>
    <div class="brands">
      <span>Sabre</span><span>Amadeus</span><span>Travelport</span><span>HotelBeds</span>
      <span>On The Beach</span><span>Secret Escapes</span><span>InteleTravel</span>
      <span>Akbar Travel</span><span>Barrhead Travel</span><span>Tarom Airlines</span><span>T-Profile</span>
    </div>
  </section>

  <!-- ===== S2 · WHAT'S IN IT FOR YOU ===== -->
  <section class="section">
    <div class="shead">
      <div class="l">
        <div class="label">What's in it for you</div>
        <h2>In-destination spend is your largest untapped opportunity for increasing revenue per booking.</h2>
      </div>
      <p class="aside">Embed a B2B2C bookable experiences marketplace into your platform, powered by AI personalisation that matches the right experience to the right traveller at the right time.</p>
    </div>

    <div class="cells">
      <div class="cell">
        <div class="wellbox">
          <div class="mock m-spend">
            <div class="cap">SPEND PER TRIP</div>
            <div class="lrow"><span>Flights</span><span class="v">captured</span></div>
            <div class="lrow"><span>Accommodation</span><span class="v">captured</span></div>
            <div class="lrow"><span>Transfers</span><span class="v">captured</span></div>
            <div class="rule"></div>
            <div class="lrow"><span class="total">Things to do</span><span class="zero">£0 to you</span></div>
          </div>
        </div>
        <div class="copy">
          <h3>That spend is being lost</h3>
          <p>Your customers are already spending in-destination. But right now, that in-destination spend is lost.</p>
        </div>
      </div>

      <div class="cell">
        <div class="wellbox">
          <div class="mock m-store">
            <div class="title"><b>On The Beach · Excursions</b><i></i></div>
            <div class="rule"></div>
            <div class="swatches">
              <i style="background:var(--tint-teal)"></i>
              <i style="background:var(--tint-cyan)"></i>
              <i style="background:var(--tint-pink)"></i>
            </div>
            <div class="lines"><i style="width:186px"></i><i style="width:124px"></i></div>
            <div class="btn-store">Explore all</div>
          </div>
        </div>
        <div class="copy">
          <h3>Drive repeat bookings by maximising the in-destination experience</h3>
          <p>Discovering, researching and booking experiences and activities is fragmented and frustrating — a radically different consumer journey to flights, hotels or other ancillaries.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== S4 · THE CONSUMER JOURNEY ===== -->
  <section class="section s4">
    <div class="shead">
      <div class="l">
        <div class="label">The consumer journey</div>
        <h2>Today's travel brands don't serve consumers in a compelling way for their in-destination needs.</h2>
      </div>
      <p class="aside">Holibob helps connect your brand with your consumers in the post core booking journey.</p>
    </div>

    <div class="cells">
      <div class="cell">
        <div class="wellbox">
          <div class="mock m-when">
            <div class="cap">WHEN THEY BOOK</div>
            <div class="tbars">
              <i style="height:12px"></i><i style="height:16px"></i><i style="height:22px"></i>
              <i style="height:38px;background:var(--tint-teal)"></i>
              <i style="height:52px;background:var(--teal-mid)"></i>
              <i style="height:66px;background:var(--teal)"></i>
              <i style="height:74px;background:var(--pink)"></i>
            </div>
            <div class="axis"><span>8 weeks out</span><span>in destination</span></div>
            <div class="rule"></div>
            <div class="pct"><b>70%</b><span>booked in the final week</span></div>
          </div>
        </div>
        <div class="copy">
          <h3>70% are booked within the week of consumption</h3>
          <p>Inspiration, discovery, booking and consumption all occur in a compressed timeframe for things-to-do.</p>
        </div>
      </div>

      <div class="cell">
        <div class="wellbox">
          <div class="mock m-match">
            <div class="who"><i></i><span>Family · Kyoto · Fri</span></div>
            <div class="rule"></div>
            <div class="mrow"><i style="background:var(--tint-teal)"></i><p>Bamboo grove e-bike tour</p><span class="s">96%</span></div>
            <div class="mrow"><i style="background:var(--tint-cyan)"></i><p>Ramen making, kids welcome</p><span class="s">91%</span></div>
            <div class="mrow off"><i style="background:var(--grey-bar)"></i><p>Sake tasting, 20+</p><span class="s">12%</span></div>
          </div>
        </div>
        <div class="copy">
          <h3>Right product, right place, right time</h3>
          <p>The wrong consumer approach leaves soft attach rates, money on the table, and lets others take credit for the lasting memories.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta">
    <h2>Turn in-destination spend into your revenue.</h2>
    <p>Embed a bookable experiences marketplace into your platform and start earning on things-to-do.</p>
    <div class="ctaform">
      <div class="ph">What's your work email?</div>
      <div class="btn-cta">Get started free</div>
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <footer class="footer">
    <div class="fcols">
      <div class="fbrand">
        <div class="wordmark">holibob<span>.tech</span></div>
        <p>Chester · London · Lisbon · Singapore</p>
      </div>
      <div class="fcol">
        <b>Platform</b>
        <a href="#">Marketplace</a><a href="#">Storefronts</a><a href="#">Payments</a><a href="#">Reporting</a>
      </div>
      <div class="fcol">
        <b>Developers</b>
        <a href="#">API reference</a><a href="#">Guides</a><a href="#">Status</a><a href="#">Changelog</a>
      </div>
      <div class="fcol">
        <b>Company</b>
        <a href="#">About</a><a href="#">Careers</a><a href="#">Press</a><a href="#">Contact</a>
      </div>
    </div>
    <div class="fbase">
      <span>1. £200,000 modelled per 1,000,000 marketable consumers.</span>
      <div class="links"><span>Privacy</span><span>Terms</span><span>Security</span></div>
    </div>
  </footer>

</div>
</body>
</html>
